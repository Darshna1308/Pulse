# ---------------------------------------------------------------------------
# Pulse local configuration. Copy to .env and replace every placeholder.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
# Local MongoDB (7.0+ required for $median/$percentile) or an Atlas URI:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pulse
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-a-different-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_IDLE_TIMEOUT_DAYS=7
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Secure cookies default to true in production; force with COOKIE_SECURE=true|false
# COOKIE_SECURE=
# Number of trusted reverse proxies in front of the API (for client IPs and rate limits)
TRUST_PROXY=0
# Demo data generation defaults to enabled outside production
# ALLOW_DEMO_DATA=true
# Sign-ups allowed per IP per hour
RATE_LIMIT_REGISTER_PER_HOUR=10
LOG_LEVEL=info

# --- ML service (services/ml) ---
ML_SERVICE_URL=http://127.0.0.1:8000
# Shared secret between the API and the ML service. Set the same value for both.
ML_SERVICE_TOKEN=replace-with-a-shared-internal-token
PULSE_ML_INTERNAL_TOKEN=replace-with-a-shared-internal-token
ML_TIMEOUT_MS=8000
# hybrid = Isolation Forest + magnitude guardrail, model = Isolation Forest only
ML_DETECTION_POLICY=hybrid

# --- Demo seed (development only) ---
# DEMO_EMAIL=demo@pulse.local
# DEMO_PASSWORD=
